# Copy to frontend/.env for local development. Never commit .env.
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_API_KEY=replace-with-your-publishable-key
SITE_KEY_CAPTCHA=replace-with-your-turnstile-site-key
