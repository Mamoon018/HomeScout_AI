# Copy to frontend/.env for local development. Never commit .env.
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_API_KEY=replace-with-your-publishable-key
SITE_KEY_CAPTCHA=replace-with-your-turnstile-site-key
# Optional. Captcha is off in dev and on in production builds by default.
# VITE_CAPTCHA_ENABLED=true
# Optional, dev only. Answers every backend call in the browser from src/mocks (no login, no
# backend). Put it in .env.local and pick a UI state with ?mock=<scenario>; see README "Mock mode".
# VITE_USE_MOCK_API=true
