# Copy to backend/.env and set real values locally. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Server-only. Needed by the R1 run endpoints (r1_runs table); never expose it to the frontend.
# Without it the app still starts, and /api/requirement-interpretation/* answers 503.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
# Upper bound in seconds on one r1_runs database call. Default 10.
# SUPABASE_DB_TIMEOUT_SECONDS=10
# Seconds after which a run still "running" is reported as failed, not retryable. Default 180.
# R1_STALE_AFTER_SECONDS=180
# Seconds after which an R2 run still "running" with no write counts as crashed and can be
# retried (reclaimed). Default 600.
# R2_STALE_AFTER_SECONDS=600
# Seconds after which an R3 run still "running" with no write counts as crashed and can be
# retried (reclaimed). Must stay above the longest STEP 4. Default 1800.
# R3_STALE_AFTER_SECONDS=1800
# Optional. Default is authenticated.
# SUPABASE_JWT_AUDIENCE=authenticated
# Access token lifetime is controlled in Supabase (Authentication → JWT Settings),
# not in this file. Use 300 seconds there when validating refresh; revert to 3600 after.
# The access_token cookie stays in the browser longer than the JWT so refresh can run.
# LOG_LEVEL=INFO is enough for refresh success/failure logs; DEBUG also shows verified token claims.
# For Deep Search, INFO prints one summary line per stage; DEBUG prints the full
# normalized input, instruction, raw provider body, and handoff state.
LOG_LEVEL=DEBUG
# Local dev only. Omit or set true in production.
CAPTCHA_ENABLED=false
# Restricted Google Maps Platform key used by the Places searchNearby client.
GOOGLE_MAPS_API=replace-with-restricted-places-api-key
# Deep Search requirement extraction. Both models must support strict JSON-schema
# structured output; a model without it fails validation instead of answering wrongly.
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_EXTRACTION_MODEL=gpt-4o-2024-08-06
GROQ_API_KEY=replace-with-your-groq-key
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
# Comma-separated. The first entry is the primary provider, the rest are fallbacks.
LLM_PROVIDER_ORDER=openai,groq
# Deep Search R2 Mechanism 3 — MCP tool gateway. Both keys are optional for local M1 work:
# the gateway is built but opens no session until a later mechanism calls it. Set them to run
# the live MCP sample runner. A keyless Parallel works at a lower anonymous rate limit. Firecrawl
# needs a key for M3: per its changelog the hosted endpoint answers 401 without a credential, so
# the gateway cannot open the session (open() raises McpConnectionError). Not verified live.
# PARALLEL_API_KEY=replace-with-your-parallel-key
# FIRECRAWL_API_KEY=replace-with-your-firecrawl-key
# Override the hosted MCP endpoints only for a proxy or a pinned version.
# PARALLEL_MCP_URL=https://search.parallel.ai/mcp
# FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp
# Page the gateway maps and scrapes once at connect to confirm the Firecrawl output shape.
# FIRECRAWL_PROBE_URL=https://example.com
# R3 app-wide web-provider limits, shared by every R3 run (set from each provider's plan; the
# limits are per account key). Parallel search slots, Firecrawl slots and Firecrawl calls per minute.
# R3_PARALLEL_SEARCH_CONCURRENCY=10
# R3_FIRECRAWL_CONCURRENCY=2
# R3_FIRECRAWL_RATE_PER_MINUTE=10
# Test-cost caps on the R1 → R2 → R3 cycle. Unset means no limit (production). Set each to 2 for
# cheap local runs: R1 keeps 2 categories (those with specific metrics first) and 2 specific
# metrics per category; R2 asks Google for 2 places per category. Applies to new R1/R2 runs only.
# MAX_CATEGORIES=2
# MAX_PLACES_PER_CATEGORY=2
# MAX_SPECIFIC_METRICS=2
