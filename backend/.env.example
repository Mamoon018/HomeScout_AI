# Copy to backend/.env and set real values locally. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Optional. Default is authenticated.
# SUPABASE_JWT_AUDIENCE=authenticated
# Access token lifetime is controlled in Supabase (Authentication → JWT Settings),
# not in this file. Use 300 seconds there when validating refresh; revert to 3600 after.
# The access_token cookie stays in the browser longer than the JWT so refresh can run.
# LOG_LEVEL=INFO is enough for refresh success/failure logs; DEBUG also shows verified token claims.
# For Deep Search, INFO prints one summary line per stage; DEBUG prints the full
# normalized input, instruction, raw provider body, and handoff state.
LOG_LEVEL=DEBUG
# Local dev only. Omit or set true in production.
CAPTCHA_ENABLED=false
# Restricted Google Maps Platform key used by the Places searchNearby client.
GOOGLE_MAPS_API=replace-with-restricted-places-api-key
# Deep Search requirement extraction. Both models must support strict JSON-schema
# structured output; a model without it fails validation instead of answering wrongly.
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_EXTRACTION_MODEL=gpt-4o-2024-08-06
GROQ_API_KEY=replace-with-your-groq-key
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
# Comma-separated. The first entry is the primary provider, the rest are fallbacks.
LLM_PROVIDER_ORDER=openai,groq
