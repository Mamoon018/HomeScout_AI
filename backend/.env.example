# Copy to backend/.env and set real values locally. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Optional. Default is authenticated.
# SUPABASE_JWT_AUDIENCE=authenticated
# Access token lifetime is controlled in Supabase (Authentication → JWT Settings),
# not in this file. Use 300 seconds there when validating refresh; revert to 3600 after.
# The access_token cookie stays in the browser longer than the JWT so refresh can run.
# LOG_LEVEL=INFO is enough for refresh success/failure logs; DEBUG also shows verified token claims.
LOG_LEVEL=DEBUG
# Local dev only. Omit or set true in production.
CAPTCHA_ENABLED=false
