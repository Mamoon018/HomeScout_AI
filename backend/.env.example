# Copy to backend/.env and set real values locally. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Optional. Default is authenticated.
# SUPABASE_JWT_AUDIENCE=authenticated
# Optional. Set to DEBUG to log verified token claims in the terminal.
LOG_LEVEL=DEBUG
# Local dev only. Omit or set true in production.
CAPTCHA_ENABLED=false
