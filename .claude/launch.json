{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd frontend && set AUTH_API_PROXY_TARGET=http://127.0.0.1:8000&& npm run dev"
      ],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd backend && .venv\\Scripts\\uvicorn.exe src.app.main:app --port 8000"
      ],
      "port": 8000
    }
  ]
}
